{
  "name": "pi-herdr-side",
  "version": "0.1.0",
  "description": "Pi extension: /side opens a forked, resumable side chat in a new Herdr pane and merges it back into the main session.",
  "type": "module",
  "license": "MIT",
  "author": "Andrei Podkovyrin",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "herdr",
    "side-chat",
    "btw"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
